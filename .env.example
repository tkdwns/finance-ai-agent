# 이 파일을 복사해서 .env 로 저장한 뒤 실제 값을 채워 넣으세요.
# .env 파일은 절대 git에 커밋하지 마세요 (.gitignore에 이미 등록되어 있습니다).
#   cp .env.example .env

# --- LLM ---
# Anthropic(Claude)과 OpenAI 중 결제 등록이 되는 쪽 하나만 채워도 된다.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# 키워드 정제(LLM) 단계에서 사용할 제공자: anthropic 또는 openai
LLM_PROVIDER=anthropic

# --- 금융 데이터 API ---
# DART(전자공시시스템) Open API - https://opendart.fss.or.kr
DART_API_KEY=your_dart_api_key_here

# 한국은행 경제통계시스템(ECOS) - https://ecos.bok.or.kr
ECOS_API_KEY=your_ecos_api_key_here

# 국토교통부 실거래가 공개시스템(공공데이터포털) - https://www.data.go.kr
MOLIT_API_KEY=your_molit_api_key_here

# 부동산 실거래가 수집 대상 지역의 법정동코드(5자리, LAWD_CD). 콤마로 구분.
# 코드는 행정표준코드관리시스템(code.go.kr) 또는 공공데이터포털 API 문서에서 확인.
# 비워두면 src/collectors/real_estate_collector.py의 REGION_PRESETS 기본값을 사용한다.
# 예: 서울 종로구=11110, 강남구=11680, 서초구=11650, 송파구=11710
REAL_ESTATE_REGIONS=

# 국가법령정보센터 Open API - https://open.law.go.kr
LAW_API_KEY=your_law_api_key_here

# 나스닥/S&P500 등 해외 지수 - FRED(세인트루이스 연방준비은행) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# --- 뉴스 RSS 피드 ---
# 콤마로 구분한 RSS 피드 URL 목록 (주식/채권 등 자산군 구분 없이 한 목록에 넣으면
# src/preprocessing/tagger.py가 제목/요약의 키워드를 보고 자동으로 자산군을 분류한다).
# 언론사 RSS는 대부분 "AI 학습 데이터 이용 시 사전 동의 필요" 같은 이용약관 조항이 있어
# (예: 한국경제 운영정책 제19조), 이 프로젝트처럼 LLM으로 자동 분석하는 용도에는
# 정부기관 보도자료(공공누리 개방 저작물, 저작권 제약이 훨씬 적음)를 기본값으로 사용한다.
# 금융위원회 공식 RSS(fsc.go.kr) - 알림마당 > 위원회 소식: 보도자료/보도설명/공지사항
NEWS_RSS_URLS=http://www.fsc.go.kr/about/fsc_bbs_rss/?fid=0111,http://www.fsc.go.kr/about/fsc_bbs_rss/?fid=0112,http://www.fsc.go.kr/about/fsc_bbs_rss/?fid=0114

# --- 데이터베이스 ---
# 초기: SQLite (파일 경로), 이후 PostgreSQL로 전환 시 DATABASE_URL 형식 사용
DATABASE_URL=sqlite:///./data/financial_agent.db
# 예: PostgreSQL 전환 시 -> postgresql://user:password@localhost:5432/financial_agent

# --- 한국어 형태소 분석 (konlpy/JVM) ---
# JDK 설치 경로. 비워두면 시스템 JAVA_HOME을 그대로 사용한다.
# VSCode 등 IDE 터미널은 프로그램을 재시작하기 전까지 옛 시스템 환경변수를 그대로
# 들고 있는 경우가 많아서, 여기에 직접 지정해두면 터미널 종류와 무관하게 동일하게 동작한다.
# 예: JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.19.10-hotspot
JAVA_HOME=

# --- 배포(선택) ---
# 이메일 자동발송용. SMTP_HOST를 비워두면 발송 기능이 비활성 상태로 남는다(스케줄러가
# 보고서 생성 후 이 값을 보고 발송 여부를 판단 — src/scheduler/jobs.py 참고).
# Gmail 사용 시: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD엔 앱 비밀번호 사용.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_FROM=
# 콤마로 구분한 수신자 목록 (예: a@example.com,b@example.com)
REPORT_EMAIL_TO=

# --- 애플리케이션 설정 ---
LOG_LEVEL=INFO
ENVIRONMENT=development
